# Copy to .env and fill in (never commit .env).
# Either name works for Channel A (reproduce.py). Prefer MODEL_API_KEY.
#
#   cp .env.example .env
#   # edit .env
#   set -a && source .env && set +a
#
# Live OpenCode (Channel B) will seed ~/.local/share/opencode/auth.json
# from these env vars only if a meta key is not already present.

MODEL_API_KEY=
# META_AI_API_KEY=

# Optional: allow reproduce.py to fall back to OpenCode auth.json when
# neither env var above is set.
# MUSE_ALLOW_OPENCODE_AUTH=1
